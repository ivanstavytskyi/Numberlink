# Copy to .env and adjust values:
#   cp .env.example .env

DB_NAME=
DB_USER=
DB_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP (transactional mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# From header; defaults to SMTP_USERNAME if empty
MAIL_FROM=
# Port 587: SMTP_STARTTLS=true, SMTP_SSL=false
# Port 465: SMTP_STARTTLS=false, SMTP_SSL=true
SMTP_STARTTLS=true
SMTP_SSL=false